# ==============================================================================
# SovereignForge & PrivyCode — Production Environment Configuration
# ==============================================================================

# Core Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
GATEWAY_PORT=8000
WORKER_PORT=8001

# Google Cloud Platform (GCP) Project & Region
GCP_PROJECT_ID=sovereignforge-prod
GCP_REGION=us-central1
GCP_ARTIFACT_REGISTRY=us-central1-docker.pkg.dev/sovereignforge-prod/privycode

# GCP Cloud SQL (PostgreSQL 16 Private IP or Localhost)
# Local Docker:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sovereignforge
# GCP Cloud SQL Private IP Example:
# DATABASE_URL=postgresql+asyncpg://sovereign_admin:YOUR_DB_PASSWORD@10.0.1.5:5432/sovereignforge?ssl=require

# GCP Memorystore (Redis 7 Private IP or Localhost)
# Local Docker:
REDIS_URL=redis://localhost:6379/0
# GCP Memorystore Private IP Example:
# REDIS_URL=redis://10.0.2.3:6379/0

# Gateway & Worker Network Endpoints
GATEWAY_URL=http://localhost:8000
MOCK_WORKER_URL=http://localhost:8001

# Inference Engine Runtime Selection (vllm | ollama | groq | mock)
INFERENCE_RUNTIME=mock
DEFAULT_MODEL=mock-qwen-32b

# Optional External Inference Backends
VLLM_BASE_URL=http://localhost:8000/v1
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=

# Rate Limiting & Quotas
DEFAULT_RPM_LIMIT=120
TOKEN_BUCKET_CAPACITY=120

# Enterprise Security & Compliance
ZERO_RETENTION_ENABLED=true
SECRET_REDACTION_ENABLED=true
